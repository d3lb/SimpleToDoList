{
  "name": "simple-list",
  "version": "1.0.1",
  "main": "electron/main.cjs",
  "scripts": {
    "web": "vite",
    "dev": "concurrently \"npm run web\" \"npm run electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && cross-env ELECTRON_DEV=true electron .",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "lint": "eslint .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "release:patch": "npm version patch && npm run release",
    "release:minor": "npm version minor && npm run release"
  },
  "build": {
    "appId": "com.simplelist.app",
    "productName": "Simple List",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "d3lb",
        "repo": "SimpleToDoList"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.9",
    "react": "^19.2.6",
    "react-contexify": "^6.0.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
